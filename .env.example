GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional fallback if Gemini is not configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Built app + API: npm run build && npm start
HOST=127.0.0.1
PORT=8787
# Set this to the exact https://your-domain.example origin behind your TLS proxy
# PUBLIC_ORIGIN=
# Limits are in memory, for one process; resetting the process resets counters
RISKVERSE_REQUESTS_PER_MINUTE=5
RISKVERSE_DAILY_ANALYSES=100
